# Fragment runs without any environment variables.
# Configure these only if you want AI-enhanced spec drafts.

# --- AI assist (optional) ---

# Anthropic Claude API key — enables AI spec drafting via Claude.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Local Ollama endpoint — alternative to Claude, runs on your machine.
# Install Ollama at https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Future integrations (parked) ---

# Figma personal access token — for the Figma watcher (not yet wired up).
# FIGMA_PAT=
